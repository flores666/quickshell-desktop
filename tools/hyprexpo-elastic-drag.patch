 using namespace std::chrono_literals;
 
+namespace {
+    CHyprSignalListener elasticFinished, elasticRemoved;
+    WP<Event::CEventBus::CCustomEvent> elasticBridge;
+}
+
+bool elasticDragEvent(int phase, PHLWINDOW window, const CBox& box) {
+    static auto enabled = CConfigValue<Config::BOOL>("animations:enabled");
+    if (phase == 0 && (!*enabled || !window || window->m_ruleApplicator->noAnim().valueOrDefault())) return false;
+    const auto found = Event::bus()->m_events.plugin.find("windows.elasticDrag");
+    if (found == Event::bus()->m_events.plugin.end()) return false;
+    if (!elasticRemoved) elasticRemoved = Event::bus()->m_events.pluginEventRemoved.listen([](const std::string& name) {
+        if (name == "windows.elasticDrag" && g_overviewDrag.elastic)
+            resetOverviewDrag(Hyprexpo::EOverviewDragEventType::Cancel);
+    });
+    if (elasticBridge.lock() != found->second) {
+        elasticBridge = found->second;
+        elasticFinished = found->second->m_event.listen([](const auto& args) {
+            if (std::get<int>(args[0]) != 4) return;
+            for (const auto& ov : g_overviews)
+                if (auto* grid = dynamic_cast<COverview*>(ov.get())) grid->refreshElastic();
+        });
+    }
+    return found->second->emit({phase, PHLWINDOWREF{window}, box.x, box.y, box.w, box.h}).has_value();
+}
+
+CBox COverview::elasticWindowBox(int tile, PHLWINDOW window) const {
+    if (!isTileValid(tile) || !window) return {};
+    const auto& image = images[tile];
+    if (image.contentBox.empty() || image.displayBox.empty()) return {};
+    const auto box = window->getWindowMainSurfaceBox();
+    return {image.displayBox.pos() + (box.pos() - image.contentBox.pos()) / image.contentBox.size() * image.displayBox.size(),
+        box.size() / image.contentBox.size() * image.displayBox.size()};
+}
