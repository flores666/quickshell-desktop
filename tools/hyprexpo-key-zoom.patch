+// quickshell-desktop: every zoom -- Super+Tab, a tile chosen, a swipe let go
+// of -- at one pace: a whole zoom takes four fifths of windowsMove's time
+// (380 ms here) and a part of one that part of it, so the overview moves as
+// fast whether a swipe is let go of a fifth of the way or four fifths. On
+// windowsMove, a zoom always took its whole time: with much left, a release
+// shot off; and easeOutQuint leaves at five times its average pace -- the
+// first frame of an open stood a third of the way there. A zoom from rest
+// eases in (Material's standard curve: 2% in its first frame, 90% in 205 ms);
+// a swipe's release is already moving, and leaves at twice its average pace,
+// slowing to a stop. Hyprland's animations still, whose clock keeps the frames
+// coming -- a zoom stepped from the frames lost them a third of the way in --
+// and only while windowsMove is on, the shell's Animations setting.
+static const char* ZOOM_FROM_REST   = "hyprexpoZoomFromRest";
+static const char* ZOOM_FROM_MOTION = "hyprexpoZoomFromMotion";
+
+void COverview::zoomTo(const Vector2D& toSize, const Vector2D& toPos, bool fromRest,
+                       std::function<void(WP<Hyprutils::Animation::CBaseAnimatedVariable>)> onEnd) {
+    // A config reload drops every curve, these with it: put back before use.
+    if (!Animation::mgr()->bezierExists(ZOOM_FROM_REST))
+        Animation::mgr()->addBezierWithName(ZOOM_FROM_REST, Vector2D{0.2, 0.0}, Vector2D{0.0, 1.0});
+    if (!Animation::mgr()->bezierExists(ZOOM_FROM_MOTION))
+        Animation::mgr()->addBezierWithName(ZOOM_FROM_MOTION, Vector2D{0.25, 0.5}, Vector2D{0.25, 1.0});
+
+    if (!zoomConfig) {
+        zoomConfig             = makeShared<Hyprutils::Animation::SAnimationPropertyConfig>();
+        zoomConfig->overridden = true;
+        zoomConfig->pValues    = zoomConfig;
+    }
+
+    const auto MOVE   = Config::animationTree()->getAnimationPropertyConfig("windowsMove");
+    const auto VALUES = MOVE ? MOVE->pValues.lock() : nullptr;
+    // In tenths of a second, as Hyprland counts animation speed.
+    const double WHOLE = (VALUES ? VALUES->internalSpeed : 4.0) * 0.8;
+    const double SHARE = std::abs(opennessFor(toSize) - openness());
+
+    zoomConfig->internalBezier  = fromRest ? ZOOM_FROM_REST : ZOOM_FROM_MOTION;
+    zoomConfig->internalEnabled = VALUES ? VALUES->internalEnabled : 1;
+    zoomConfig->internalStyle   = VALUES ? VALUES->internalStyle : "";
+    zoomConfig->internalSpeed   = std::max(0.8, WHOLE * SHARE);
+
+    size->setConfig(zoomConfig);
+    pos->setConfig(zoomConfig);
+    // From wherever the zoom stands: a close taken back turns round on it.
+    *size = toSize;
+    *pos  = toPos;
+    pos->setCallbackOnEnd(nullptr);
+    size->setCallbackOnEnd(std::move(onEnd));
+}
+
+// quickshell-desktop: a close is taken back -- the toggle pressed again while
+// the overview closes -- unless it changed workspace.
+bool COverview::canReopen() const {
+    return closing && !m_switchedOnClose && pMonitor.lock();
+}
+
+bool COverview::reopen() {
+    if (!canReopen())
+        return false;
+
+    const auto MON   = pMonitor.lock();
+    closing          = false;
+    m_closeCommitted = false;
+    closeOnID        = -1;
+    m_closeFromSwipe = false;
+    enterSubmapIfEnabled();
+    zoomTo(MON->m_size, {0, 0}, true, [this](auto) { redrawAll(true); });
+    return true;
+}
