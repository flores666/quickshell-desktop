+// quickshell-desktop: the toggle pressed again while every overview is still
+// closing opens them back from where they stand, if each can be. False when
+// there is nothing of the kind to take back.
+bool reopenClosingOverviews() {
+    bool any = false, all = true;
+    forEachOverview([&](IOverviewSession& overview) {
+        any = true;
+        all = all && overview.closeCommitted() && overview.canReopen();
+    });
+    if (!any || !all)
+        return false;
+    forEachOverview([](IOverviewSession& overview) { overview.reopen(); });
+    return true;
+}
