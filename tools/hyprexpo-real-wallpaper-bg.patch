 #include <hyprland/src/state/WorkspaceState.hpp>
 #include <hyprland/src/state/MonitorState.hpp>
 #include <hyprland/src/managers/eventLoop/EventLoopManager.hpp>
@@ -343,11 +346,51 @@ void COverview::fullRender() {
     const auto SHAPE   = currentGridShape();
 
     clearWithColor(BG_COLOR.stripA());
-    if (wallpaperBg && MON->m_background) {
+    if (wallpaperBg) {
         CRegion backgroundDamage{0, 0, INT16_MAX, INT16_MAX};
         CBox    backgroundBox{{0, 0}, MON->m_transformedSize};
-        Render::GL::g_pHyprOpenGL->renderTextureInternal(MON->m_background, backgroundBox, {.damage = &backgroundDamage, .a = 1.0f});
-        Render::GL::g_pHyprOpenGL->renderRect(backgroundBox, CHyprColor{0x00000066}, {});
+        bool    drewWallpaper = false;
+
+        // What the user calls "the wallpaper" is a background layer surface owned by
+        // hyprpaper/swaybg/etc. renderWorkspace normally draws it, but the plugin hooks
+        // that away while the overview is up, so draw it here. MON->m_background is
+        // Hyprland's built-in wall*.png asset, which is only the wallpaper on a session
+        // where nothing claims the background layer -- keep it as the fallback.
+        for (const auto& LSREF : MON->m_layerSurfaceLayers[ZWLR_LAYER_SHELL_V1_LAYER_BACKGROUND]) {
+            const auto LS = LSREF.lock();
+            if (!LS || !LS->m_mapped)
+                continue;
+
+            const auto SURFACE = LS->resource();
+            if (!SURFACE || !SURFACE->m_current.texture)
+                continue;
+
+            CBox surfaceBox = LS->m_geometry;
+            surfaceBox.translate(-MON->m_position).scale(MON->m_scale).round();
+            Render::GL::g_pHyprOpenGL->renderTextureInternal(SURFACE->m_current.texture, surfaceBox, {.damage = &backgroundDamage, .a = 1.0f});
+            drewWallpaper = true;
+        }
+
+        if (!drewWallpaper && MON->m_background) {
+            Render::GL::g_pHyprOpenGL->renderTextureInternal(MON->m_background, backgroundBox, {.damage = &backgroundDamage, .a = 1.0f});
+            drewWallpaper = true;
+        }
+
+        // Frost the wallpaper so the tiles read as the foreground. This is Hyprland's own
+        // blur of what has been drawn so far, but at a backdrop strength: the user's
+        // decoration:blur is tuned for glass behind windows and barely softens a
+        // wallpaper, so it is raised for this one call and put straight back.
+        if (drewWallpaper) {
+            static CConfigValue<Config::INTEGER> PBLURSIZE("decoration:blur:size");
+            static CConfigValue<Config::INTEGER> PBLURPASSES("decoration:blur:passes");
+            const auto                           SAVEDSIZE   = *PBLURSIZE;
+            const auto                           SAVEDPASSES = *PBLURPASSES;
+            *PBLURSIZE.ptr()                                 = 8;
+            *PBLURPASSES.ptr()                               = 4;
+            Render::GL::g_pHyprOpenGL->renderRect(backgroundBox, CHyprColor{0x00000066}, {.damage = &backgroundDamage, .blur = true});
+            *PBLURSIZE.ptr()   = SAVEDSIZE;
+            *PBLURPASSES.ptr() = SAVEDPASSES;
+        }
     }
 
     auto* const* PTILEROUND  = (Hyprlang::INT* const*)HyprlandAPI::getConfigValue(PHANDLE, "plugin:hyprexpo:tile_rounding")->getDataStaticPtr();
