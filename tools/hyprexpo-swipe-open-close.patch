+    return std::max<Hyprlang::INT>(0, **PGAPSO) * openness();
+}
+
+// quickshell-desktop: how far open the overview is, from 0 with the current
+// tile filling the screen to 1 with the grid fitting it, read off the zoom
+// itself. Upstream read the clock of the animation driving the zoom, but a
+// swipe moves the zoom without one: the gaps were all there on a swipe's
+// first frame, vanished as the fingers lifted and grew back after, and went
+// at once on a swipe that closes. A grid of one tile does not zoom.
+double COverview::openness() const {
+    const auto MON = pMonitor.lock();
+    if (!MON)
+        return 0.0;
+
+    const double SHUT = zoomSizeForCurrentGrid(MON->m_size).x;
+    const double OPEN = MON->m_size.x;
+    if (std::abs(SHUT - OPEN) <= 1e-6)
+        return closing ? 0.0 : 1.0;
+
+    return std::clamp((SHUT - size->value().x) / (SHUT - OPEN), 0.0, 1.0);
 }
 
