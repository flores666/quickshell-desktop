+// quickshell-desktop: the top and overlay layers -- the bar, the dock, their
+// popups -- are no part of a workspace, and main.cpp draws them over the
+// overview where they stand. So each workspace is taken without them: set
+// aside for the one render and put back after it, with anything added
+// meanwhile.
+class CShellLayersAside {
+  public:
+    explicit CShellLayersAside(const PHLMONITOR& monitor) : m_monitor(monitor) {
+        if (!g_shellAboveOverview || !monitor)
+            return;
+        for (size_t i = 0; i < LAYERS.size(); ++i)
+            std::swap(monitor->m_layerSurfaceLayers[LAYERS[i]], m_aside[i]);
+        m_active = true;
+    }
+
+    ~CShellLayersAside() {
+        if (!m_active)
+            return;
+        for (size_t i = 0; i < LAYERS.size(); ++i) {
+            auto& layers = m_monitor->m_layerSurfaceLayers[LAYERS[i]];
+            std::swap(layers, m_aside[i]);
+            layers.insert(layers.end(), m_aside[i].begin(), m_aside[i].end());
+        }
+    }
+
+    CShellLayersAside(const CShellLayersAside&)            = delete;
+    CShellLayersAside& operator=(const CShellLayersAside&) = delete;
+
+  private:
+    static constexpr std::array<uint32_t, 2> LAYERS = {ZWLR_LAYER_SHELL_V1_LAYER_TOP, ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY};
+    PHLMONITOR                               m_monitor;
+    std::array<std::vector<PHLLSREF>, 2>     m_aside;
+    bool                                     m_active = false;
+};
