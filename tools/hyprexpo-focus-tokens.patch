+    addConfigValue(makeShared<Config::Values::CStringValue>("plugin:hyprexpo:focus_curve", "tile focus bezier: x1 y1 x2 y2", "0.22 1 0.36 1",
+        Config::Values::SStringValueOptions{.validator = validateFocusCurve}));
+    addConfigValue(makeShared<Config::Values::CFloatValue>("plugin:hyprexpo:focus_zoom", "workspace zoom at full focus", 0.02F,
+        Config::Values::SFloatValueOptions{.min = 0.F, .max = 1.F}));
+    addConfigValue(makeShared<Config::Values::CFloatValue>("plugin:hyprexpo:current_focus", "resting focus of the current workspace", 0.4F,
+        Config::Values::SFloatValueOptions{.min = 0.F, .max = 1.F}));
     addConfigValue(makeShared<Config::Values::CIntValue>("plugin:hyprexpo:dynamic_grid", "legacy dynamic grid toggle", HyprexpoConfig::LEGACY_DYNAMIC_GRID_DEFAULT));
