+// quickshell-desktop: the focus curve comes from config/Motion.qml.
+static std::expected<void, std::string> validateFocusCurve(const Config::STRING& value) {
+    std::istringstream in(value);
+    double x1, y1, x2, y2;
+    std::string extra;
+    if (!(in >> x1 >> y1 >> x2 >> y2) || (in >> extra) || !std::isfinite(x1) || !std::isfinite(y1) ||
+        !std::isfinite(x2) || !std::isfinite(y2) || x1 < 0 || x1 > 1 || x2 < 0 || x2 > 1)
+        return std::unexpected("expected four finite bezier coordinates, x in [0, 1]");
+    return {};
+}
+
