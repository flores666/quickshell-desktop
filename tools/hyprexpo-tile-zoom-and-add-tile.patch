     bool              entryAnimationPending = false;
     const double      entryElapsed = entryAnimationActive ? std::chrono::duration<double>(std::chrono::steady_clock::now() - createdAt).count() : 0.0;
 
+    // quickshell-desktop: focus zoom. A tile is highlighted not by a border
+    // but by the workspace in it growing inside the tile's own rounded edge,
+    // which stays put, so it reads as a camera focusing on the desktop rather
+    // than a card lifting. The zoom is a crop: the middle of the capture fills
+    // the tile's box. The tile under the pointer (or the keyboard) is in full
+    // focus and the current workspace rests part of the way there. No tile is
+    // in focus as the overview opens: the pointer takes focus only once it has
+    // moved in it, and the keyboard has none until a key is pressed.
+    // A tile whose target changes eases from wherever it stands, so a pointer
+    // sweeping across the grid never snaps one, on an ease-out that settles
+    // without overshoot -- or jumps there with Hyprland's animations off,
+    // which is the shell's Animations setting. While the overview closes the
+    // zoom unwinds with the close, as the gaps do, so the chosen workspace
+    // still lands exactly on the screen.
+    static CConfigValue<Config::INTEGER> PANIMATIONS("animations:enabled");
+    static const auto                    FOCUS_EASE = [] {
+        Hyprutils::Animation::CBezierCurve curve;
+        curve.setup({Vector2D{0.22, 1.0}, Vector2D{0.36, 1.0}});
+        return curve;
+    }();
+    constexpr double FOCUS_SECONDS = 0.4;
+    constexpr double FOCUS_IMAGE   = 0.02; // the workspace, at full focus
+    const auto       FOCUS_NOW     = std::chrono::steady_clock::now();
+    const int        FOCUSED       = pointerMoved && hoveredID >= 0 ? hoveredID : kbFocusID;
+    const double     FOCUS_SETTLE  = closing ? 1.0 - size->getPercent() : 1.0;
+    if (tileFocus.size() != images.size())
+        tileFocus.assign(images.size(), {});
+    bool focusPending = false;
+    auto focusNow     = [&](const STileFocus& focus) -> double {
+        const double elapsed = std::chrono::duration<double>(FOCUS_NOW - focus.since).count();
+        const double t       = *PANIMATIONS ? elapsed / FOCUS_SECONDS : 1.0;
+        if (t < 1.0)
+            focusPending = true;
+        return focus.from + (focus.to - focus.from) * FOCUS_EASE.getYForPoint((float)t);
+    };
+
     for (size_t y = 0; y < (size_t)SHAPE.rows; ++y) {
         for (size_t x = 0; x < (size_t)SHAPE.cols; ++x) {
